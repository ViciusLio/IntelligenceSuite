# LLM Locale (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Escalation (opzionale — funziona senza)
ANTHROPIC_API_KEY=
ESCALATION_THRESHOLD=0.70
ESCALATION_MAX_TOKENS=4096

# Vector Store
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./.chroma
# PGVECTOR_DSN=postgresql://user:pass@localhost:5432/intelligence_suite

# Server
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Embedding
EMBED_BACKEND=ollama
EMBED_BATCH_SIZE=32
