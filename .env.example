# ── LLM generation backend ────────────────────────────────────────────────────
# Choices: ollama | openai | vllm | claude
LLM_BACKEND=ollama

# Ollama (local — default, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=300    # seconds — increase for slow CPU or long answers (default: 300)

# OpenAI / vLLM / Groq / Mistral / any OpenAI-compatible server
# For vLLM: set OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# ── Escalation policy ────────────────────────────────────────────────────────
# When retrieval confidence < threshold, escalate to Claude API (if key is set)
ESCALATION_THRESHOLD=0.70
ESCALATION_MAX_TOKENS=4096

# ── Embedding backend ────────────────────────────────────────────────────────
# Choices: ollama | st (sentence-transformers) | claude (voyage)
EMBED_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32

# SentenceTransformer model (used when EMBED_BACKEND=st)
# English only, fast (default):
ST_MODEL=all-MiniLM-L6-v2
# Multilingual 50+ languages (Italian, French, Spanish, German, ...):
# ST_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Multilingual, higher quality (768-dim):
# ST_MODEL=paraphrase-multilingual-mpnet-base-v2

# ── API authentication (v0.9.1) ──────────────────────────────────────────────
# IS_AUTH_ENABLED=false (default) → no checks, identical to v0.8.x.
# IS_AUTH_ENABLED=true  → all /api/v1/* endpoints require:
#     Authorization: Bearer <IS_API_KEY>
# /health and / (web UI) remain public regardless.
# IS_AUTH_ENABLED=false
# IS_API_KEY=change-me-in-production

# ── Observability (v0.9.2) ───────────────────────────────────────────────────
# Structured logging (JSON to stdout) + opt-in in-memory metrics endpoint.
# All defaults preserve v0.9.1 behaviour.
#   IS_LOG_LEVEL    standard logging level (DEBUG|INFO|WARNING|ERROR). Default INFO.
#   IS_LOG_FORMAT   json (default — one JSON object per line) | text (dev-friendly).
#   IS_METRICS_ENABLED  false (default) → GET /metrics returns 404 (no route).
#                       true  → GET /metrics returns in-memory counters as JSON.
# NOTE: question/answer text is NEVER logged — only metadata (e.g. question length).
# IS_LOG_LEVEL=INFO
# IS_LOG_FORMAT=json
# IS_METRICS_ENABLED=false

# ── On-demand ingestion (v0.11+) ─────────────────────────────────────────────
# Opt-in HTTP routes + UI panel to parse+embed content on demand (idempotent),
# in addition to the offline ci-embed/di-embed/pi-embed CLIs. All defaults
# preserve prior behaviour: when disabled the routes return 404 and no UI panel
# is shown.
#   IS_INGEST_ENABLED  false (default) → POST /api/v1/ingest/* absent (404).
#                      true  → mounts path/upload/status routes + UI "Indicizza".
#   IS_INGEST_ROOT     server-side root the /ingest/path endpoint is confined to
#                      (empty → path ingest disabled; upload still works).
#   IS_INGEST_MAX_MB   per-file upload cap in MB (default 50; 413 on overflow).
# Upload route also needs the [ingest] extra (python-multipart).
# IS_INGEST_ENABLED=false
# IS_INGEST_ROOT=
# IS_INGEST_MAX_MB=50

# ── Multi-project namespacing (v0.9) ─────────────────────────────────────────
# Isolate collections and state dirs per project/tenant.
# Default ("default") → single-project layout, identical to v0.8.x behaviour.
# Set to any slug (alphanumeric + _-) to activate project isolation:
#   collections: acme_code_intelligence, acme_doc_intelligence, …
#   state dirs:  ~/.intelligence_suite/acme/chroma|graph|eval|skill_sessions/
# IS_PROJECT=default

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE=chromadb
# Default (absolute path — works from any working directory):
#   ~/.intelligence_suite/chroma   (Linux/macOS)
#   C:\Users\<you>\.intelligence_suite\chroma  (Windows)
# Override here only if you need a custom location (ignored when IS_PROJECT != default):
# CHROMA_PERSIST_DIR=./.chroma
# PGVECTOR_DSN=postgresql://user:pass@localhost:5432/intelligence_suite

# ── Per-module LLM routing (optional) ────────────────────────────────────────
# Override the global LLM_BACKEND for each module independently.
# Leave empty to use the global settings above.
#
# Example: CodeIntelligence → vLLM GPU server with code-specialised model
# CI_LLM_BACKEND=openai
# CI_LLM_MODEL=codellama:34b
# CI_LLM_BASE_URL=http://gpu-server:8000/v1
# CI_LLM_API_KEY=
#
# Example: DocIntelligence → local Mistral (better multilingual / Italian)
# DI_LLM_BACKEND=ollama
# DI_LLM_MODEL=mistral:7b
#
# Example: MentorIntelligence → Claude API (best pedagogical quality)
# MI_LLM_BACKEND=claude
# MI_LLM_MODEL=claude-sonnet-4-5
# MI_LLM_API_KEY=sk-ant-...

# ── Server ports (one per module — run all three simultaneously) ──────────────
CI_PORT=8080       # CodeIntelligence   → http://localhost:8080
DI_PORT=8081       # DocIntelligence    → http://localhost:8081
MI_PORT=8082       # MentorIntelligence → http://localhost:8082
LAUNCHER_PORT=8079 # Launcher dashboard → http://localhost:8079  (is-launch)

API_HOST=0.0.0.0
LOG_LEVEL=INFO
